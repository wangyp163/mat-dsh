# HPC remote-shell 密钥（sk- 开头，HPC 密钥中心创建）—— Gaussian 全流程唯一必需凭证
MAT_MCP_KEY=sk-xxxxxxxx
# 可选：MCP 网关覆盖（默认 https://mcp-gateway.example.internal/api；开发网关如 http://mcp-dev-gw.internal:32399）
MAT_MCP_BASE_URL=
# OpenAI 兼容 LLM 端点（如 HPC 网关；vasp-matstream-dsh spike 已验证该模式）
LLM_BASE_URL=
LLM_API_KEY=
# 模型 id（须为网关真实 id；spike 实测 HPC 网关为 deepseek-v4-pro / deepseek-v4-flash）
LLM_MODEL_ID=deepseek-v4-pro
# BigModel GLM 密钥（https://open.bigmodel.cn → API Keys；glm-5.3-flash 图像/思考用）
BIGMODEL_API_KEY=
# 默认模型路由 id：mat（deepseek 双模型）或 bigmodel（glm-5.3-flash，多模态）
LLM_PROVIDER_ID=mat
# 可选：OPTIMADE 结构检索 MCP 端点（vasp-calc 结构来源；默认 profiles/mat.yml 内置 ksai 实例）
OPTIMADE_MCP_URL=
# 可选：matgen 材料筛选/生成 MCP 端点（默认经 scripts/matgen-tunnel.sh 隧道 127.0.0.1:18080）
MATGEN_MCP_URL=
# matgen 容器 pod（matgen-mcp-pod:50046 root）ssh 密码——隧道脚本用；与上面端点二选一起效前，隧道是必需通路
MATGEN_POD_SSHPASS=
