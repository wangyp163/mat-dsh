{
  "name": "mat-ui",
  "version": "0.1.0",
  "description": "HPC Web UI 增强：品牌、会话归档、状态板卡片（harmony Source Patches + web client 模块）",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "assets",
    "turn-fold-compat.patch.cjs",
    "details-tab-reactivity.patch.cjs"
  ],
  "dsh": {
    "harmony": {
      "patches": [
        "./turn-fold-compat.patch.cjs",
        "./details-tab-reactivity.patch.cjs"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "mat-core": "workspace:*",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-tool": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.8",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
