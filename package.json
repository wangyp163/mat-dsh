{
  "name": "mat-dsh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b && tsc --noEmit -p scripts",
    "test": "vitest run",
    "session-debug": "tsx scripts/session-debug.ts",
    "stress:report-lint": "tsx scripts/stress-report-lint.ts",
    "build:mat-ui": "node scripts/build-mat-ui.mjs",
    "debug:session": "tsx scripts/session-debug.ts",
    "dsh": "pnpm --dir ../deepseek-harness dsh",
    "eval:run": "tsx scripts/eval-run.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "eval:fake": "tsx scripts/eval-fake-mat.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cordis": "link:../deepseek-harness/vendor/cordis",
      "@deepseek-ai/schemastery": "link:../deepseek-harness/vendor/schemastery",
      "@deepseek-ai/dsh-tools": "link:../deepseek-harness/packages/core/tools",
      "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
      "@deepseek-ai/dsh-system-prompt": "link:../deepseek-harness/packages/core/system-prompt",
      "@deepseek-ai/dsh-jobs": "link:../deepseek-harness/packages/jobs/jobs",
      "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
      "@deepseek-ai/dsh-skill": "link:../deepseek-harness/packages/skill/skill",
      "@deepseek-ai/dsh-mcp-client": "link:../deepseek-harness/packages/mcp/mcp-client",
      "@deepseek-ai/dsh-tool-subagent": "link:../deepseek-harness/packages/subagent/tool-subagent",
      "@deepseek-ai/dsh-client-ui-theme": "link:../deepseek-harness/packages/client/ui-theme",
      "@deepseek-ai/dsh-client-ui-tool": "link:../deepseek-harness/packages/client/ui-tool",
      "@deepseek-ai/dsh-client-ui-conversation": "link:../deepseek-harness/packages/client/ui-conversation",
      "@deepseek-ai/dsh-client-ui-layout": "link:../deepseek-harness/packages/client/ui-layout",
      "@deepseek-ai/dsh-client-ui-sidebar": "link:../deepseek-harness/packages/client/ui-sidebar",
      "@deepseek-ai/dsh-client-ui-primitives": "link:../deepseek-harness/packages/client/ui-primitives"
    }
  }
}
